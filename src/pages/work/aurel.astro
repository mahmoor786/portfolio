---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import Demo from '../../layouts/Demo.astro';
const items = [
  { n: 'Halo lamp', c: 'Lighting', p: 420, a: '#ffb27a', b: '#c9507a' },
  { n: 'Dune vase', c: 'Objects', p: 180, a: '#e9c98c', b: '#a8743a' },
  { n: 'Mist throw', c: 'Textiles', p: 240, a: '#b9c6ff', b: '#6a5cd6' },
  { n: 'Ember bowl', c: 'Objects', p: 150, a: '#ff9a8b', b: '#8a2f4d' },
  { n: 'Arc sconce', c: 'Lighting', p: 360, a: '#f6e7c8', b: '#b98a4a' },
  { n: 'Tide rug', c: 'Textiles', p: 890, a: '#9fd8cf', b: '#2f6f73' },
];
const cats = ['All', 'Objects', 'Lighting', 'Textiles'];
---
<Demo title="Aurel" theme="#0d0d10" cls="aurel">
  <header class="hero">
    <nav><a class="logo" href="#">Aurel</a><div><a href="#collection">Collection</a><a href="#atelier">Atelier</a><a href="#atelier">Journal</a><a href="#collection">Bag (<span id="bag">0</span>)</a></div></nav>
    <div class="orb"></div>
    <div class="copy">
      <h1>Quiet luxury,<br /><em>delivered.</em></h1>
      <p>Handmade pieces for considered living.</p>
      <a class="btn" href="#collection">Explore →</a>
    </div>
    <ul class="cats"><li>01 &nbsp;Objects</li><li>02 &nbsp;Lighting</li><li>03 &nbsp;Textiles</li><li>04 &nbsp;Bespoke</li></ul>
  </header>
  <section id="collection">
    <div class="top"><h2>The collection</h2><div class="filter">{cats.map((c, i) => <button class={i === 0 ? 'on' : ''} data-cat={c}>{c}</button>)}</div></div>
    <div class="grid">
      {items.map((i) => (
        <article data-cat={i.c}>
          <div class="art" style={`--a:${i.a};--b:${i.b}`}><i></i></div>
          <div class="row"><div><h3>{i.n}</h3><small>{i.c}</small></div><b>${i.p}</b></div>
          <button class="add">Add to bag</button>
        </article>
      ))}
    </div>
  </section>
  <section id="atelier" class="atelier">
    <p>“Every piece is made slowly, by hand, in small batches. Nothing leaves the atelier until it is right.”</p>
    <small>Aurel Atelier</small>
  </section>
  <style is:global>
    .aurel{background:#0d0d10;color:#f4efe6}
    .aurel .hero{position:relative;min-height:min(100vh,800px);padding:0 5vw;display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(135deg,#0d0d10,#1c1a22)}
    .aurel nav{display:flex;justify-content:space-between;align-items:center;padding:34px 0;position:relative;z-index:2;font-size:14px}
    .aurel nav div a{margin-left:28px;opacity:.7}.aurel nav div a:hover{opacity:1}
    .aurel .logo{font:italic 400 30px "Instrument Serif",Georgia,serif}
    .aurel .orb{position:absolute;right:-6%;top:50%;width:min(62vw,800px);aspect-ratio:1;transform:translateY(-50%);border-radius:50%;
      background:radial-gradient(circle,#ffb27a 0%,#c9507a 38%,rgba(60,40,140,0) 70%);animation:aurel-orb 9s ease-in-out infinite}
    @keyframes aurel-orb{50%{transform:translateY(-52%) scale(1.06)}}
    .aurel .copy{position:relative;z-index:2;margin:auto 0;padding:40px 0}
    .aurel h1{margin:0;font:400 clamp(52px,8.2vw,104px)/1.02 "Instrument Serif",Georgia,serif;letter-spacing:-.01em}
    .aurel .copy p{font-size:clamp(16px,1.9vw,22px);opacity:.65;margin:22px 0 34px}
    .aurel .btn{display:inline-block;padding:17px 34px;border-radius:99px;background:#f4efe6;color:#0d0d10;font-weight:600}
    .aurel .cats{position:relative;z-index:2;list-style:none;margin:0;padding:22px 0 30px;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(244,239,230,.25);font-size:15px;opacity:.75}
    .aurel section{padding:90px 5vw}
    .aurel .top{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:40px}
    .aurel h2{margin:0;font:400 clamp(38px,5vw,60px)/1 "Instrument Serif",Georgia,serif}
    .aurel .filter button{background:none;border:1px solid rgba(244,239,230,.25);color:inherit;padding:9px 18px;border-radius:99px;margin-left:8px;font-size:14px}
    .aurel .filter .on{background:#f4efe6;color:#0d0d10}
    .aurel .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
    .aurel article[hidden]{display:none}
    .aurel .art{aspect-ratio:4/5;border-radius:6px;background:#17161c;display:grid;place-items:center;overflow:hidden}
    .aurel .art i{width:52%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,var(--a),var(--b));box-shadow:0 30px 60px rgba(0,0,0,.5);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
    .aurel article:hover .art i{transform:scale(1.12)}
    .aurel .row{display:flex;justify-content:space-between;align-items:start;margin:18px 0 14px}
    .aurel h3{margin:0 0 4px;font:400 26px "Instrument Serif",Georgia,serif}.aurel small{opacity:.55;font-size:13px}.aurel .row b{font-weight:500}
    .aurel .add{width:100%;padding:13px;border-radius:99px;background:none;border:1px solid rgba(244,239,230,.3);color:inherit;font-size:14px;transition:.2s}
    .aurel .add:hover,.aurel .add.done{background:#f4efe6;color:#0d0d10}
    .aurel .atelier{text-align:center;border-top:1px solid rgba(244,239,230,.14)}
    .aurel .atelier p{font:italic 400 clamp(26px,3.6vw,44px)/1.25 "Instrument Serif",Georgia,serif;max-width:900px;margin:0 auto 20px}
    @media(max-width:820px){.aurel .grid{grid-template-columns:repeat(2,1fr);gap:16px}.aurel nav div a{margin-left:16px}.aurel nav div a:nth-child(2),.aurel nav div a:nth-child(3){display:none}.aurel .cats{grid-template-columns:repeat(2,1fr);gap:10px}.aurel .orb{width:110vw;right:-40%;opacity:.8}}
  </style>
  <script>
    let n = 0;
    document.querySelectorAll<HTMLButtonElement>('.aurel .add').forEach((b) => b.addEventListener('click', () => {
      if (b.classList.contains('done')) return;
      b.classList.add('done'); b.textContent = 'Added ✓';
      document.getElementById('bag')!.textContent = String(++n);
    }));
    const fb = document.querySelectorAll<HTMLButtonElement>('.aurel .filter button');
    fb.forEach((b) => b.addEventListener('click', () => {
      fb.forEach((x) => x.classList.toggle('on', x === b));
      document.querySelectorAll<HTMLElement>('.aurel article').forEach((a) => (a.hidden = b.dataset.cat !== 'All' && a.dataset.cat !== b.dataset.cat));
    }));
  </script>
</Demo>
